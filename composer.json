{
    "name": "jpmmartin/sylius-nmi-plugin",
    "type": "sylius-plugin",
    "description": "NMI payment gateway for Sylius: card payments, 3-D Secure, refunds and voids",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "payment",
        "payment-gateway",
        "nmi"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "sylius/sylius": "^2.2",
        "symfony/intl": "^6.4 || ^7.4"
    },
    "require-dev": {
        "behat/behat": "^3.16",
        "dbrekelmans/bdi": "^1.4",
        "dmore/behat-chrome-extension": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-doctrine": "^1.3",
        "phpstan/phpstan-webmozart-assert": "^1.2",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2",
        "sylius/refund-plugin": "^2.1",
        "sylius/sylius-rector": "^2.0",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "suggest": {
        "sylius/refund-plugin": "^2.1 — to refund from the refund plugin’s own screens as well as from the order screen. It must be told to offer this gateway: add \"nmi\" to the sylius_refund.supported_gateways parameter."
    },
    "autoload": {
        "psr-4": {
            "JpmMartin\\SyliusNmiPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\JpmMartin\\SyliusNmiPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "scripts": {
        "check": [
            "@ecs",
            "@phpstan",
            "@phpunit",
            "@behat"
        ],
        "ecs": "vendor/bin/ecs check",
        "phpstan": "vendor/bin/phpstan analyse",
        "phpunit": "vendor/bin/phpunit",
        "behat": "vendor/bin/behat --strict --no-interaction --tags \"~@javascript\"",
        "behat-js": "vendor/bin/behat --strict --no-interaction --tags \"@javascript\"",
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migration:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "yarn install",
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    },
    "scripts-descriptions": {
        "check": "ECS, PHPStan, PHPUnit and Behat (non-JavaScript), stopping at the first failure",
        "ecs": "Coding standard (sylius-labs/coding-standard), check only",
        "phpstan": "Static analysis of src/ at the level set in phpstan.neon",
        "phpunit": "PHPUnit suites (Unit, Integration, Functional)",
        "behat": "Behat scenarios that need no browser; needs the test database migrated",
        "behat-js": "Behat @javascript scenarios; needs a web server on BEHAT_BASE_URL and Chrome on 127.0.0.1:9222"
    }
}
