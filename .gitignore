/vendor/
/var/
/node_modules/
/drivers/
/composer.lock

/etc/build/*
!/etc/build/.gitignore

/.phpunit.result.cache
/behat.yml
/phpunit.xml
/compose.override.yml
.phpunit.result.cache

# Symfony CLI https://symfony.com/doc/current/setup/symfony_server.html#different-php-settings-per-project
/.php-version
/php.ini

/tests/TestApplication/.env.local
/tests/TestApplication/.env.*.local

# Spec-Driven Development artifacts, kept out of the published package by choice.
# Note this diverges from CLAUDE.md Rule 3 ("specs stay in the repo as living
# documentation") and leaves the Rule 4 commit footer `Refs: specs/...` pointing at
# paths no other clone can resolve. The specs exist only in the author's working copy.
/specs/
