/vendor/
/var/
/node_modules/
/drivers/
/composer.lock

/etc/build/*
!/etc/build/.gitignore

/.phpunit.result.cache
/behat.yml
/phpunit.xml
/compose.override.yml
.phpunit.result.cache

# Symfony CLI https://symfony.com/doc/current/setup/symfony_server.html#different-php-settings-per-project
/.php-version
/php.ini

# Per-developer IDE settings. They belong to a machine, not to a published package.
/.idea/
/.vscode/
/*.iml

# PHPUnit 10 result cache (cacheDirectory in phpunit.xml.dist).
/.phpunit.cache/

/tests/TestApplication/.env.local
/tests/TestApplication/.env.*.local

# Generated per machine by `vendor/bin/console sylius:payment:generate-key`; never a shared secret.
/tests/TestApplication/config/encryption/

# Left from the hand-rolled spec workflow this project used before adopting OpenSpec.
# No specs/ directory exists any more — the planning record lives in openspec/, ignored
# below for the same reason. Kept as a guard so a stray specs/ can never be committed.
/specs/

# Claude Code working files, kept out of the published package by choice — same reasoning
# as specs/ above. The skills are authoring tools for this repository, not part of what a
# consumer installs. settings.local.json is per-developer by convention in any case.
/.claude/skills/
/.claude/settings.local.json

###> graphify ###
# graphify is a local authoring tool, not part of the published package, and nothing
# it produces or configures belongs in the repository.
#
# The generated graph (graph.json, graph.html, GRAPH_REPORT.md) is a build artefact:
# it is regenerated from the sources on every update, so tracking it would grow the
# history with hundreds of kilobytes per rebuild while adding nothing a clone cannot
# recreate. The hooks and merge driver would also force graphify on anyone who clones
# this repo, and their tooling would fail without it installed.
/graphify-out/
/.gitattributes
/.claude/settings.json
/.claude/CLAUDE.md
.claude/settings.json.graphify-bak
###< graphify ###

###> openspec ###
# OpenSpec is a local planning tool, and everything it produces is the same class of
# material as specs/ above: proposals, delta specs, designs and task lists.
#
# CLAUDE.md Rule 3 decides this: the planning record is private. This is a community
# plugin with a single developer — what ships is the plugin, not the author's record of
# how he documented building it. Tracking openspec/ would reverse that decision.
#
# .claude/commands/opsx/* are the CLI's slash commands — authoring tools for whoever
# writes the specs, never something a consumer of this plugin installs. Same reasoning
# as .claude/skills/ above, which already covers the openspec-* skills.
/openspec/
/.claude/commands/opsx/
###< openspec ###
