/vendor/
/var/
/node_modules/
/drivers/
/composer.lock

/etc/build/*
!/etc/build/.gitignore

/.phpunit.result.cache
/behat.yml
/phpunit.xml
/compose.override.yml
.phpunit.result.cache

# Symfony CLI https://symfony.com/doc/current/setup/symfony_server.html#different-php-settings-per-project
/.php-version
/php.ini

# Per-developer IDE settings. They belong to a machine, not to a published package.
/.idea/
/.vscode/
/*.iml

# PHPUnit 10 result cache (cacheDirectory in phpunit.xml.dist).
/.phpunit.cache/

/tests/TestApplication/.env.local
/tests/TestApplication/.env.*.local

# Generated per machine by `vendor/bin/console sylius:payment:generate-key`; never a shared secret.
/tests/TestApplication/config/encryption/

# Left from a hand-rolled spec workflow this project once used. No specs/ directory exists
# any more; kept as a guard so a stray specs/ can never be committed.
/specs/

# Claude Code working files, kept out of the published package by choice — same reasoning
# as specs/ above. The skills are authoring tools for this repository, not part of what a
# consumer installs. settings.local.json is per-developer by convention in any case.
/.claude/skills/
/.claude/settings.local.json
