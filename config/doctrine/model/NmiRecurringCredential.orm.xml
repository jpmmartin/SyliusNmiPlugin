<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <!--
        A card kept on a promise of recurring charges. Its own table rather than a kind of stored card
        or card on file: a saved card is offered back to its shopper and a card on file is let go by
        the charge this one has to survive, so either table would put the other promise's rules on
        these rows.

        The three identifier columns hold ciphertext and are sized for it. The four display columns
        may be empty, as a card on file's may: by the time the gateway's answer is read the vault
        record exists, and refusing to keep a card the gateway failed to describe would strand it.
    -->
    <mapped-superclass name="JpmMartin\SyliusNmiPlugin\Entity\NmiRecurringCredential" table="jpm_martin_sylius_nmi_recurring_credential">
        <unique-constraints>
            <!-- One credential per opening payment, held by the database: two submissions of the pay
                 page arriving together would both pass a select-then-insert. -->
            <unique-constraint name="uniq_jpm_martin_sylius_nmi_recurring_credential_payment" columns="initial_payment_id" />
        </unique-constraints>

        <id name="id" column="id" type="integer">
            <generator strategy="IDENTITY" />
        </id>

        <field name="vaultId" column="vault_id" type="text" />
        <!-- A sale, an authorisation or a verification that stores a card reports none. -->
        <field name="billingId" column="billing_id" type="text" nullable="true" />
        <field name="initialTransactionId" column="initial_transaction_id" type="text" nullable="true" />

        <field name="brand" column="brand" type="string" length="32" nullable="true" />
        <field name="lastFour" column="last_four" type="string" length="4" nullable="true" />
        <field name="expiryMonth" column="expiry_month" type="smallint" nullable="true" />
        <field name="expiryYear" column="expiry_year" type="smallint" nullable="true" />

        <field name="status" column="status" type="string" length="16" />
        <field name="releasedAt" column="released_at" type="datetime_immutable" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" nullable="true" />

        <!-- Set to null, neither cascaded nor restricted: the promise outlives the order that started
             it. Cascading would drop the row with its order and strand the vault record at the
             gateway; restricting would make deleting an old order fail for a reason its operator
             cannot see. -->
        <one-to-one field="initialPayment" target-entity="Sylius\Component\Core\Model\PaymentInterface">
            <join-column name="initial_payment_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </one-to-one>

        <!-- Cascaded, as a stored card's is: the customer-deletion listener reads these rows before
             the delete and queues their removal at the gateway. A guest order has a customer too. -->
        <many-to-one field="customer" target-entity="Sylius\Component\Core\Model\CustomerInterface">
            <join-column name="customer_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <!-- Restricted, as the other two records' are: deleting a payment method that still holds
             credentials would strand vault records at the gateway. -->
        <many-to-one field="paymentMethod" target-entity="Sylius\Component\Core\Model\PaymentMethodInterface">
            <join-column name="payment_method_id" referenced-column-name="id" nullable="false" on-delete="RESTRICT" />
        </many-to-one>
    </mapped-superclass>
</doctrine-mapping>
