<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults public="false" />

        <service id="jpm_martin_sylius_nmi.recorder.transaction" class="JpmMartin\SyliusNmiPlugin\Recorder\NmiTransactionRecorder">
            <argument type="service" id="jpm_martin_sylius_nmi.factory.nmi_transaction" />
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_transaction" />
            <argument type="service" id="jpm_martin_sylius_nmi.manager.nmi_transaction" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.amount_formatter" />
        </service>
        <service id="JpmMartin\SyliusNmiPlugin\Recorder\NmiTransactionRecorderInterface" alias="jpm_martin_sylius_nmi.recorder.transaction" />

        <service id="jpm_martin_sylius_nmi.recorder.stored_card" class="JpmMartin\SyliusNmiPlugin\Recorder\NmiStoredCardRecorder">
            <argument type="service" id="jpm_martin_sylius_nmi.factory.nmi_stored_card" />
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_stored_card" />
            <argument type="service" id="jpm_martin_sylius_nmi.manager.nmi_stored_card" />
            <argument type="service" id="jpm_martin_sylius_nmi.stored_card.default" />
        </service>
        <service id="JpmMartin\SyliusNmiPlugin\Recorder\NmiStoredCardRecorderInterface" alias="jpm_martin_sylius_nmi.recorder.stored_card" />
    </services>
</container>
