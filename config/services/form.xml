<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults public="false" />

        <!--
            Autoconfiguration does the tagging: the #[AsGatewayConfigurationType] attribute yields
            the `sylius.gateway_configuration_type` tag that registers the factory, and being a form
            type yields `form.type`.
        -->
        <service id="jpm_martin_sylius_nmi.form.type.gateway_configuration" class="JpmMartin\SyliusNmiPlugin\Form\Type\NmiGatewayConfigurationType" autoconfigure="true" />
    </services>
</container>
