<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults public="false" />

        <!--
            The platform reaches a gateway through one command provider registered under the
            factory name. That provider is the framework's own, indexed by action over a
            locator private to this plugin, so nothing here can collide with another gateway's
            providers even when both handle the same action.
        -->
        <service id="jpm_martin_sylius_nmi.command_provider" class="Sylius\Bundle\PaymentBundle\CommandProvider\ActionsCommandProvider">
            <argument type="tagged_locator" tag="jpm_martin_sylius_nmi.payment_request.command_provider" index-by="action" />
            <tag name="sylius.payment_request.command_provider" gateway-factory="nmi" />
        </service>

        <!--
            Both actions reach the same provider: sale versus authorise is chosen upstream from
            the payment method's configuration, and by here it is already decided.
        -->
        <service id="jpm_martin_sylius_nmi.command_provider.card_payment" class="JpmMartin\SyliusNmiPlugin\CommandProvider\CardPaymentCommandProvider">
            <tag name="jpm_martin_sylius_nmi.payment_request.command_provider" action="capture" />
            <tag name="jpm_martin_sylius_nmi.payment_request.command_provider" action="authorize" />
        </service>

        <service id="jpm_martin_sylius_nmi.command_provider.refund" class="JpmMartin\SyliusNmiPlugin\CommandProvider\RefundCommandProvider">
            <tag name="jpm_martin_sylius_nmi.payment_request.command_provider" action="refund" />
        </service>

        <!--
            The pay page's response. One service per gateway factory, and this one decides on the
            action itself rather than going through a second locator: there is one page.
        -->
        <service id="jpm_martin_sylius_nmi.provider.http_response" class="JpmMartin\SyliusNmiPlugin\Provider\NmiHttpResponseProvider">
            <argument type="service" id="twig" />
            <tag name="sylius.payment_request.provider.http_response" gateway-factory="nmi" />
        </service>

        <!--
            Handlers. The bus carries the doctrine_transaction middleware, so each of these runs
            inside a transaction that commits on return: persist, never flush.
        -->
        <service id="jpm_martin_sylius_nmi.command_handler.prepare_card_payment" class="JpmMartin\SyliusNmiPlugin\CommandHandler\PrepareCardPaymentHandler">
            <argument type="service" id="sylius.provider.payment_request" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.amount_formatter" />
            <tag name="messenger.message_handler" bus="sylius.payment_request.command_bus" />
        </service>

        <service id="jpm_martin_sylius_nmi.command_handler.complete_card_payment" class="JpmMartin\SyliusNmiPlugin\CommandHandler\CompleteCardPaymentHandler">
            <argument type="service" id="sylius.provider.payment_request" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.client" />
            <argument type="service" id="jpm_martin_sylius_nmi.recorder.transaction" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="messenger.message_handler" bus="sylius.payment_request.command_bus" />
        </service>

        <service id="jpm_martin_sylius_nmi.command_handler.capture_payment" class="JpmMartin\SyliusNmiPlugin\CommandHandler\CapturePaymentHandler">
            <argument type="service" id="sylius.provider.payment_request" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.client" />
            <argument type="service" id="jpm_martin_sylius_nmi.recorder.transaction" />
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_transaction" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="messenger.message_handler" bus="sylius.payment_request.command_bus" />
        </service>

        <!--
            Runs before the operator's click completes the payment, because a payment marked
            completed cannot be moved back if the gateway then refuses.
        -->
        <service id="jpm_martin_sylius_nmi.listener.capture_payment" class="JpmMartin\SyliusNmiPlugin\EventListener\CapturePaymentListener">
            <argument type="service" id="sylius.factory.payment_request" />
            <argument type="service" id="sylius.repository.payment_request" />
            <argument type="service" id="sylius.announcer.payment_request" />
            <tag name="kernel.event_listener" event="sylius.payment.pre_complete" />
        </service>

        <!--
            Shipping is a fact about the world, so this one cannot refuse it: a refused capture
            leaves the payment authorised with the reason recorded, rather than undoing a parcel.
        -->
        <service id="jpm_martin_sylius_nmi.listener.capture_on_shipment" class="JpmMartin\SyliusNmiPlugin\EventListener\CaptureOnShipmentListener">
            <argument type="service" id="sylius.factory.payment_request" />
            <argument type="service" id="sylius.repository.payment_request" />
            <argument type="service" id="sylius.announcer.payment_request" />
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_transaction" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="kernel.event_listener" event="workflow.sylius_shipment.completed.ship" />
        </service>

        <service id="jpm_martin_sylius_nmi.command_handler.cancel_payment" class="JpmMartin\SyliusNmiPlugin\CommandHandler\CancelPaymentHandler">
            <argument type="service" id="sylius.provider.payment_request" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.client" />
            <argument type="service" id="jpm_martin_sylius_nmi.recorder.transaction" />
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_transaction" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="messenger.message_handler" bus="sylius.payment_request.command_bus" />
        </service>

        <!-- Before the cancel, for the same reason the capture runs before the complete. -->
        <service id="jpm_martin_sylius_nmi.listener.void_payment" class="JpmMartin\SyliusNmiPlugin\EventListener\VoidPaymentListener">
            <argument type="service" id="sylius.factory.payment_request" />
            <argument type="service" id="sylius.repository.payment_request" />
            <argument type="service" id="sylius.announcer.payment_request" />
            <tag name="kernel.event_listener" event="sylius.payment.pre_cancel" />
        </service>

        <service id="jpm_martin_sylius_nmi.command_handler.refund_payment" class="JpmMartin\SyliusNmiPlugin\CommandHandler\RefundPaymentHandler">
            <argument type="service" id="sylius.provider.payment_request" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.client" />
            <argument type="service" id="jpm_martin_sylius_nmi.recorder.transaction" />
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_transaction" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="messenger.message_handler" bus="sylius.payment_request.command_bus" />
        </service>

        <!-- Before the refund, for the same reason as the other two: nothing leaves refunded. -->
        <service id="jpm_martin_sylius_nmi.listener.refund_payment" class="JpmMartin\SyliusNmiPlugin\EventListener\RefundPaymentListener">
            <argument type="service" id="sylius.factory.payment_request" />
            <argument type="service" id="sylius.repository.payment_request" />
            <argument type="service" id="sylius.announcer.payment_request" />
            <tag name="kernel.event_listener" event="sylius.payment.pre_refund" />
        </service>

        <service id="jpm_martin_sylius_nmi.command_handler.report_payment_status" class="JpmMartin\SyliusNmiPlugin\CommandHandler\ReportPaymentStatusHandler">
            <argument type="service" id="sylius.provider.payment_request" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="messenger.message_handler" bus="sylius.payment_request.command_bus" />
        </service>

        <!--
            The pay flow ends by minting a status request. Every gateway has to answer it: without
            this the shopper's last redirect fails with an unsupported-action error.
        -->
        <service id="jpm_martin_sylius_nmi.command_provider.status" class="JpmMartin\SyliusNmiPlugin\CommandProvider\StatusCommandProvider">
            <tag name="jpm_martin_sylius_nmi.payment_request.command_provider" action="status" />
        </service>

        <!-- A void: the payment state machine has no void transition, so it travels as a cancel. -->
        <service id="jpm_martin_sylius_nmi.command_provider.cancel" class="JpmMartin\SyliusNmiPlugin\CommandProvider\CancelCommandProvider">
            <tag name="jpm_martin_sylius_nmi.payment_request.command_provider" action="cancel" />
        </service>
    </services>
</container>
