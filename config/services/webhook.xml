<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <!--
            Durable, unlike the received-event record beside it: a chargeback matters for months
            and the replay guard is measured in days, so they cannot be the same row.
        -->
        <service id="jpm_martin_sylius_nmi.recorder.gateway_notice" class="JpmMartin\SyliusNmiPlugin\Recorder\NmiGatewayNoticeRecorder">
            <argument type="service" id="jpm_martin_sylius_nmi.factory.nmi_gateway_notice" />
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_gateway_notice" />
            <argument type="service" id="doctrine.orm.default_entity_manager" />
        </service>

        <service id="JpmMartin\SyliusNmiPlugin\Recorder\NmiGatewayNoticeRecorderInterface" alias="jpm_martin_sylius_nmi.recorder.gateway_notice" />

        <!--
            Finds a card by a reference nothing can query, because it is encrypted with a
            non-deterministic cipher. It brings back two columns and decrypts them rather than
            hydrating the table.
        -->
        <service id="jpm_martin_sylius_nmi.webhook.stored_card_locator" class="JpmMartin\SyliusNmiPlugin\Webhook\NmiStoredCardLocator">
            <argument type="service" id="doctrine.orm.default_entity_manager" />
            <argument type="service" id="sylius.encrypter" />
            <argument>%jpm_martin_sylius_nmi.model.nmi_stored_card.class%</argument>
        </service>

        <service id="JpmMartin\SyliusNmiPlugin\Webhook\NmiStoredCardLocatorInterface" alias="jpm_martin_sylius_nmi.webhook.stored_card_locator" />

        <!-- What the card networks reported, applied entry by entry. -->
        <service id="jpm_martin_sylius_nmi.webhook.card_update_applier" class="JpmMartin\SyliusNmiPlugin\Webhook\NmiCardUpdateApplier">
            <argument type="service" id="jpm_martin_sylius_nmi.webhook.stored_card_locator" />
            <argument type="service" id="doctrine.orm.default_entity_manager" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="sylius.event_bus" />
            <argument type="service" id="logger" />
        </service>

        <!--
            No condition on this one. A chargeback has no setting to hide it, so neither has the
            page that shows it — and the page is empty until the gateway reports something.
        -->
        <service id="jpm_martin_sylius_nmi.listener.admin_main_menu" class="JpmMartin\SyliusNmiPlugin\Menu\AdminMainMenuListener">
            <tag name="kernel.event_listener" event="sylius.menu.admin.main" method="addGatewayNotices" />
        </service>

        <!--
            Takes the model class rather than the table name, so a store that replaced the resource
            is written to through its own mapping instead of a name hardcoded in the ledger.
        -->
        <service id="jpm_martin_sylius_nmi.webhook.ledger" class="JpmMartin\SyliusNmiPlugin\Webhook\NmiReceivedEventLedger">
            <argument type="service" id="doctrine.orm.default_entity_manager" />
            <argument>%jpm_martin_sylius_nmi.model.nmi_received_event.class%</argument>
        </service>

        <service id="JpmMartin\SyliusNmiPlugin\Webhook\NmiReceivedEventLedgerInterface" alias="jpm_martin_sylius_nmi.webhook.ledger" />

        <!--
            Turns a verified event into a payment request with the notify action, so the store's
            record of what the gateway told it sits beside its record of what it asked the gateway.
        -->
        <service id="jpm_martin_sylius_nmi.webhook.router" class="JpmMartin\SyliusNmiPlugin\Webhook\NmiWebhookRouter">
            <argument type="service" id="jpm_martin_sylius_nmi.repository.nmi_transaction" />
            <argument type="service" id="sylius.factory.payment_request" />
            <argument type="service" id="sylius.repository.payment_request" />
            <argument type="service" id="sylius.announcer.payment_request" />
            <argument type="service" id="jpm_martin_sylius_nmi.recorder.gateway_notice" />
            <argument type="service" id="jpm_martin_sylius_nmi.webhook.card_update_applier" />
            <argument type="service" id="logger" />
        </service>

        <service id="JpmMartin\SyliusNmiPlugin\Webhook\NmiWebhookRouterInterface" alias="jpm_martin_sylius_nmi.webhook.router" />
    </services>
</container>
