<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <imports>
        <import resource="services/**" />
    </imports>

    <services>
        <service id="JpmMartin\SyliusNmiPlugin\Controller\CompleteCardPaymentAction" public="true">
            <argument type="service" id="sylius.repository.payment_request" />
            <argument type="service" id="sylius.announcer.payment_request" />
            <argument type="service" id="security.csrf.token_manager" />
            <argument type="service" id="sylius_shop.provider.order_pay.after_pay_url" />
            <argument type="service" id="translator" />
        </service>

        <!--
            Hands the browser the vault reference it needs to authenticate a stored card, and
            nothing else. Its whole reason for existing is that the reference is then never
            rendered into the page.
        -->
        <service id="JpmMartin\SyliusNmiPlugin\Controller\StoredCardAuthenticationAction" public="true">
            <argument type="service" id="sylius.repository.payment_request" />
            <argument type="service" id="security.csrf.token_manager" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="jpm_martin_sylius_nmi.provider.stored_card_offer" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.amount_formatter" />
        </service>

        <!--
            The public endpoint. It takes the repository and the configuration provider and nothing
            else: resolving a payment method and reading its signing key is all it may do before a
            delivery has been proven to come from the gateway.
        -->
        <service id="JpmMartin\SyliusNmiPlugin\Controller\WebhookAction" public="true">
            <argument type="service" id="sylius.repository.payment_method" />
            <argument type="service" id="jpm_martin_sylius_nmi.gateway.configuration_provider" />
            <argument type="service" id="jpm_martin_sylius_nmi.webhook.ledger" />
            <argument type="service" id="jpm_martin_sylius_nmi.webhook.router" />
            <argument type="service" id="logger" />
        </service>
    </services>
</container>
