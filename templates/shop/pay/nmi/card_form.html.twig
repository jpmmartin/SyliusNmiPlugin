{% set nmi = hookable_metadata.context.nmi %}
{% set payment_request = hookable_metadata.context.payment_request %}

<h1>{{ 'jpm_martin_sylius_nmi.shop.pay.heading'|trans }}</h1>

<p>
    {{ 'jpm_martin_sylius_nmi.shop.pay.amount'|trans }}
    <strong {{ sylius_test_html_attribute('nmi-amount') }}>
        {{ nmi.amount|sylius_format_money(nmi.currency_code, sylius.localeCode) }}
    </strong>
</p>

{#
    Everything the script needs, on the element that holds the card fields. The tokenization key
    is public by design — it identifies the merchant and cannot charge anything. The amount stays
    in minor units here because that is what the gateway is given, not what a shopper reads.
#}
{#
    Marked as belonging to the new-card path so that choosing a saved card can put it away. The
    attribute rather than the id, so a store that overrode this template keeps the behaviour by
    keeping the attribute — and so the save-this-card option, which is a separate hookable, can
    carry the same mark.
#}
<div
    data-nmi-payment
    data-nmi-new-card-only
    data-nmi-tokenization-key="{{ nmi.tokenization_key }}"
    data-nmi-amount="{{ nmi.amount }}"
    data-nmi-currency="{{ nmi.currency_code }}"
    data-nmi-action="{{ nmi.action }}"
    data-nmi-payment-request="{{ payment_request.id }}"
    {# Where the token goes once the browser has it, and the token that proves the shopper asked. #}
    data-nmi-action-url="{{ path('jpm_martin_sylius_nmi_shop_complete_card_payment', { hash: payment_request.id }) }}"
    data-nmi-csrf-token="{{ csrf_token('jpm_martin_sylius_nmi_pay_' ~ payment_request.id) }}"
    {#
        What the issuer is told about the shopper when the card is authenticated. The name and the
        decimal amount are required by the authentication call; the rest is optional and sent
        because the gateway states plainly that the more it receives, the less likely the shopper
        is to be challenged.
    #}
    data-nmi-amount-major="{{ nmi.amount_major }}"
    {% for field in ['first_name', 'last_name', 'email', 'address1', 'city', 'postal_code', 'state', 'country', 'phone'] %}
        {% if nmi[field] is defined %}data-nmi-{{ field|replace({'_': '-'}) }}="{{ nmi[field] }}"{% endif %}
    {% endfor %}
    {# Shown on the page by the script, so they are translated here rather than in JavaScript. #}
    data-nmi-error-message="{{ 'jpm_martin_sylius_nmi.shop.pay.card_unreadable'|trans }}"
    data-nmi-auth-failed-message="{{ 'jpm_martin_sylius_nmi.shop.pay.not_authenticated'|trans }}"
    data-nmi-unavailable-message="{{ 'jpm_martin_sylius_nmi.shop.pay.form_unavailable'|trans }}"
    {{ sylius_test_html_attribute('nmi-payment') }}
>
    {{ include('@JpmMartinSyliusNmiPlugin/shop/pay/nmi/card_fields.html.twig') }}
</div>
