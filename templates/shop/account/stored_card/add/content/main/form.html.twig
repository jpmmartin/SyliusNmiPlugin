{#
    The same mount point the pay page uses, and the same component behind it — the card is entered
    inside the gateway's own frames and the only thing this page ever receives is a token.

    Two attributes the pay page carries are missing on purpose. There is no amount, because nothing
    is being charged. And there is no 3-D Secure container, so the component does not authenticate:
    authenticating a card nobody is charging has nothing to authorise.
#}
{% set customer = hookable_metadata.context.customer %}

<div
    id="nmi-payment"
    data-nmi-tokenization-key="{{ hookable_metadata.context.tokenization_key }}"
    data-nmi-action-url="{{ path('jpm_martin_sylius_nmi_shop_account_stored_card_add') }}"
    data-nmi-csrf-token=""
    data-nmi-first-name="{{ customer.firstName }}"
    data-nmi-last-name="{{ customer.lastName }}"
    data-nmi-email="{{ customer.email }}"
    data-nmi-error-message="{{ 'jpm_martin_sylius_nmi.shop.pay.card_unreadable'|trans }}"
    {#
        Ask the browser to name the brand. The vault call answers with the masked number and the
        expiry and **no brand** — established against the gateway — so without this the card cannot
        be described and the record would be left at the gateway with nothing pointing at it.
    #}
    data-nmi-describe-card
    {{ sylius_test_html_attribute('nmi-add-card') }}
></div>
