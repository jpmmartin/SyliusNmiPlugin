DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/jpm_martin_sylius_nmi_plugin_%kernel.environment%?serverVersion=16&charset=utf8

# The purge that forgets a card at the gateway is queued on purpose, so a test can only see it by
# reading the queue. In memory is what makes the queue readable — and it keeps the suite from
# writing rows to a Doctrine transport nobody in it consumes.
SYLIUS_MESSENGER_TRANSPORT_MAIN_DSN=in-memory://
SYLIUS_MESSENGER_TRANSPORT_MAIN_FAILED_DSN=in-memory://
