DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/jpm_martin_sylius_nmi_plugin_%kernel.environment%?serverVersion=16&charset=utf8

BEHAT_BASE_URL="http://127.0.0.1:8080/"

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@JpmMartinSyliusNmiPlugin/tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@JpmMartinSyliusNmiPlugin/tests/TestApplication/config/routes.yaml"

# Sylius encrypts gateway configuration at rest with a key file. Its default location is inside
# vendor/sylius/test-application, which every composer install recreates, so the key lives here.
# Generate it once with: vendor/bin/console sylius:payment:generate-key
SYLIUS_PAYMENT_ENCRYPTION_KEY_PATH=%kernel.project_dir%/../../../tests/TestApplication/config/encryption/key

# The gateway host the suite's fixtures put on the payment methods they build. Empty means NMI's
# sandbox host. A store has no such variable: the host is typed into the payment method form.
NMI_API_BASE_URL=

# The two-phase card flow only works when payment-request commands are handled synchronously:
# the pay page announces the command and then asks for a response in the same request, so a
# queued command would leave the page with nothing to render. Sylius's own default is sync://;
# sylius/test-application overrides it to a Doctrine queue, which this puts back.
SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_DSN=sync://
