<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <!--
            Sylius's payment method pages, subclassed so they know this plugin's gateway fields.
            Overriding the class parameters keeps every Sylius context that uses these pages working.
        -->
        <parameter key="sylius.behat.page.admin.payment_method.create.class">Tests\JpmMartin\SyliusNmiPlugin\Behat\Page\Admin\PaymentMethod\CreatePage</parameter>
        <parameter key="sylius.behat.page.admin.payment_method.update.class">Tests\JpmMartin\SyliusNmiPlugin\Behat\Page\Admin\PaymentMethod\UpdatePage</parameter>
        <parameter key="sylius.behat.page.admin.payment_method.index.class">Tests\JpmMartin\SyliusNmiPlugin\Behat\Page\Admin\PaymentMethod\IndexPage</parameter>
    </parameters>

    <services>
        <defaults public="true" />

        <!--
            Sylius's context maps a gateway factory's label to its name through a hard-coded list
            that only knows "Offline". Redefined here with NMI added, so
            "I want to create a new payment method with "NMI" gateway factory" resolves.
        -->
        <service id="sylius.behat.context.ui.admin.managing_payment_methods" class="Sylius\Behat\Context\Ui\Admin\ManagingPaymentMethodsContext">
            <argument type="service" id="sylius.behat.page.admin.payment_method.create" />
            <argument type="service" id="sylius.behat.page.admin.payment_method.index" />
            <argument type="service" id="sylius.behat.page.admin.payment_method.update" />
            <argument type="service" id="sylius.behat.current_page_resolver" />
            <argument type="collection">
                <argument key="offline">Offline</argument>
                <argument key="nmi">NMI</argument>
            </argument>
        </service>

        <service id="jpm_martin_sylius_nmi.context.ui.admin.managing_nmi_payment_methods" class="Tests\JpmMartin\SyliusNmiPlugin\Behat\Context\Ui\Admin\ManagingNmiPaymentMethodsContext">
            <argument type="service" id="sylius.behat.page.admin.payment_method.create" />
            <argument type="service" id="sylius.behat.page.admin.payment_method.update" />
            <argument type="service" id="sylius.behat.page.admin.payment_method.index" />
            <argument type="service" id="doctrine.dbal.default_connection" />
        </service>

        <!--
            The shopper's saved-cards page. Not one of Sylius's, so it is registered here rather
            than overridden.
        -->
        <service id="jpm_martin_sylius_nmi.behat.page.shop.account.stored_card.index" class="Tests\JpmMartin\SyliusNmiPlugin\Behat\Page\Shop\Account\StoredCardIndexPage" parent="sylius.behat.symfony_page" />

        <service id="jpm_martin_sylius_nmi.context.setup.stored_card" class="Tests\JpmMartin\SyliusNmiPlugin\Behat\Context\Setup\NmiStoredCardContext">
            <argument type="service" id="sylius.behat.shared_storage" />
            <argument type="service" id="jpm_martin_sylius_nmi.factory.nmi_stored_card" />
            <argument type="service" id="sylius.factory.payment_method" />
            <argument type="service" id="sylius.factory.gateway_config" />
            <argument type="service" id="sylius.repository.customer" />
            <argument type="service" id="doctrine.orm.default_entity_manager" />
        </service>

        <service id="jpm_martin_sylius_nmi.context.ui.shop.managing_nmi_stored_cards" class="Tests\JpmMartin\SyliusNmiPlugin\Behat\Context\Ui\Shop\ManagingNmiStoredCardsContext">
            <argument type="service" id="jpm_martin_sylius_nmi.behat.page.shop.account.stored_card.index" />
        </service>

    </services>
</container>
